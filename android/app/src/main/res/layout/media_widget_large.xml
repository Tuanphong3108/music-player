<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_big"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_art_box"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_art_bg"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Album Art"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/widget_meta_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Media Player"
                android:textColor="#F5EFF7"
                android:textSize="15.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Chạm để mở trình phát"
                android:textColor="#CAC4D0"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_pos_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#CAC4D0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_drawable" />

        <TextView
            android:id="@+id/widget_dur_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#CAC4D0"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_ctrl_btn_bg"
            android:contentDescription="Previous"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#F5EFF7" />
        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/widget_play_btn_bg"
            android:contentDescription="Play or Pause"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_play"
            android:tint="#1C1B1F" />
        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_ctrl_btn_bg"
            android:contentDescription="Next"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_next"
            android:tint="#F5EFF7" />
    </LinearLayout>
</LinearLayout>
