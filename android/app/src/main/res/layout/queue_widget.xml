<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/queue_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/queue_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/queue_widget_art"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_art_bg"
            android:contentDescription="Album Art"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/queue_widget_now_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Media Player"
                android:textColor="#F5EFF7"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/queue_widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tiếp theo trong hàng đợi"
                android:textColor="#D0BCFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/queue_widget_play"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_play_btn_bg"
            android:contentDescription="Play or Pause"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_play"
            android:tint="#1C1B1F" />
    </LinearLayout>

    <TextView
        android:id="@+id/queue_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Chưa có bài hát nào trong hàng đợi"
        android:textColor="#CAC4D0"
        android:textSize="12.5sp" />

    <LinearLayout
        android:id="@+id/queue_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/queue_row_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_queue_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/queue_row_0_num"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#D0BCFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/queue_row_0_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#F5EFF7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/queue_row_0_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxEms="7"
                android:maxLines="1"
                android:text=""
                android:textColor="#CAC4D0"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/queue_row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_queue_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/queue_row_1_num"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="#D0BCFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/queue_row_1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#F5EFF7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/queue_row_1_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxEms="7"
                android:maxLines="1"
                android:text=""
                android:textColor="#CAC4D0"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/queue_row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_queue_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/queue_row_2_num"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="#D0BCFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/queue_row_2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#F5EFF7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/queue_row_2_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxEms="7"
                android:maxLines="1"
                android:text=""
                android:textColor="#CAC4D0"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/queue_row_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_queue_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/queue_row_3_num"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="4"
                android:textColor="#D0BCFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/queue_row_3_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#F5EFF7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/queue_row_3_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxEms="7"
                android:maxLines="1"
                android:text=""
                android:textColor="#CAC4D0"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
