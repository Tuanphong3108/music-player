<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/widget_art_box"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/widget_art_bg">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Album Art"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Media Player"
            android:textColor="#F5EFF7"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Chạm để mở trình phát"
            android:textColor="#CAC4D0"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_ctrl_btn_bg"
            android:contentDescription="Previous"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#F5EFF7" />

        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_play_btn_bg"
            android:contentDescription="Play or Pause"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_play"
            android:tint="#1C1B1F" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_ctrl_btn_bg"
            android:contentDescription="Next"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_next"
            android:tint="#F5EFF7" />
    </LinearLayout>
</LinearLayout>
